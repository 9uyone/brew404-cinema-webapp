@model WebApp.ViewModels.FilterMoviesViewModel

<link rel="stylesheet" href="@Url.Content("~/css/moviePage.css")">

<!-- Loading Indicator -->
<div class="loading-indicator" style="display: none;">
    <div class="spinner-border text-primary"></div>
</div>

<!-- Пошук фільмів -->
<div class="search-container mb-3">
    <h2 class="mb-4">Пошук фільмів</h2>

    <div id="poda" class="d-flex align-items-center position-relative">
        <!-- Фонові ефекти -->
        <div class="grid"></div>
        <div class="glow"></div>
        <div class="darkBorderBg"></div>
        <div class="white"></div>
        <div class="border"></div>
        
        <!-- Основний інпут -->
        <div id="main" class="w-100 position-relative">
            <div class="input-wrapper position-relative">
                <input 
                    id="searchInput"
                    placeholder="Пошук..." 
                    type="text" 
                    name="searchQuery" 
                    class="input w-100" 
                />
                <div id="input-mask"></div>
                <div id="pink-mask"></div>
            </div>
            
            <!-- Кнопка фільтра -->
            <div class="filterBorder"></div>
            <button id="filter-icon" class="filter-button" type="button">
                <svg
                    preserveAspectRatio="none"
                    height="24"
                    width="24"
                    viewBox="4.8 4.56 14.832 15.408"
                    fill="none"
                >
                    <path
                        d="M8.16 6.65002H15.83C16.47 6.65002 16.99 7.17002 16.99 7.81002V9.09002C16.99 9.56002 16.7 10.14 16.41 10.43L13.91 12.64C13.56 12.93 13.33 13.51 13.33 13.98V16.48C13.33 16.83 13.1 17.29 12.81 17.47L12 17.98C11.24 18.45 10.2 17.92 10.2 16.99V13.91C10.2 13.5 9.97 12.98 9.73 12.69L7.52 10.36C7.23 10.08 7 9.55002 7 9.20002V7.87002C7 7.17002 7.52 6.65002 8.16 6.65002Z"
                        stroke="#d6d6e6"
                        stroke-width="1.2"
                        stroke-miterlimit="10"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    />
                </svg>
            </button>
        </div>
    </div>
</div>

<!-- Блок фільтрації -->
<div class="filter-container" id="filterContainer">
    <!-- Жанри -->
    <div class="filter-section">
        <button type="button" class="filter-button" data-filter="genres">
            <span>Жанри</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 9l6 6 6-6"/>
            </svg>
        </button>
        <div class="filter-dropdown">
            @foreach (var genre in Model.Genres)
            {
                <div class="multiselect-option">
                    <label>
                        <input type="checkbox" name="GenreIds" value="@genre.Id">
                        @genre.Name
                    </label>
                </div>
            }
        </div>
    </div>

    <!-- Рік -->
    <div class="filter-section">
        <button type="button" class="filter-button" data-filter="year">
            <span>Рік</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 9l6 6 6-6"/>
            </svg>
        </button>
        <div class="filter-dropdown">
            <input type="number" name="Year" class="form-control" 
                   min="1900" max="@DateTime.Now.Year" 
                   placeholder="Введіть рік">
        </div>
    </div>

    <!-- Сортування -->
    <div class="filter-section">
        <button type="button" class="filter-button" data-filter="sort">
            <span>Сортування</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 9l6 6 6-6"/>
            </svg>
        </button>
        <div class="filter-dropdown">
            <select name="SortBy" class="form-control mb-2">
                <option value="Title">За назвою</option>
                <option value="ReleaseDate">За датою</option>
            </select>
            <select name="Descending" class="form-control">
                <option value="false">За зростанням</option>
                <option value="true">За спаданням</option>
            </select>
        </div>
    </div>
</div>

<!-- Список фільмів -->
<div id="moviesGrid" class="container mt-5">
    <div class="row d-flex justify-content-start" id="movieResults">
        @foreach(var movie in Model.Movies)
        {
            <div class="col-md-4 col-sm-6 col-12 mb-3">
                <a asp-action="Details" asp-controller="Home" asp-route-id="@movie.Id" class="text-decoration-none">
                    <div class="card movie-card">
                        <img src="@movie.ImageUrl" class="card-img" alt="@movie.Title">
                        <div class="rating-badge">@movie.VoteAverage ⭐</div>
                        <div class="card-body">
                            <h5 class="card-title">@movie.Title</h5>
                            <p class="movie-year">@movie.ReleaseDate</p>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('searchInput');
    const filterIcon = document.getElementById('filter-icon');
    const filterContainer = document.getElementById('filterContainer');
    const filterButtons = document.querySelectorAll('.filter-button');
    const movieResults = document.getElementById('movieResults');

    // Filter dropdown toggle
    filterButtons.forEach(button => {
        button.addEventListener('click', (e) => {
            const section = button.closest('.filter-section');
            const wasOpen = section.classList.contains('open');
            
            // Close all open filters
            document.querySelectorAll('.filter-section').forEach(s => {
                s.classList.remove('open');
                s.querySelector('.filter-button').classList.remove('active');
            });
            
            // Open the clicked section if it was not already open
            if (!wasOpen) {
                section.classList.add('open');
                button.classList.add('active');
            }
        });
    });

    // Close dropdowns when clicking outside
    document.addEventListener('click', (e) => {
        if (!e.target.closest('.filter-section') && !e.target.closest('#filter-icon')) {
            document.querySelectorAll('.filter-section').forEach(section => {
                section.classList.remove('open');
                section.querySelector('.filter-button').classList.remove('active');
            });
        }
    });

    // Toggle filter container visibility
    filterIcon.addEventListener('click', () => {
        filterContainer.classList.toggle('d-none');
    });

    // Search functionality
    searchInput.addEventListener('input', function() {
        const searchTerm = this.value.toLowerCase();
        const movieCards = document.querySelectorAll('.movie-card');

        movieCards.forEach(card => {
            const title = card.querySelector('.card-title').textContent.toLowerCase();
            if (title.includes(searchTerm)) {
                card.closest('.col-md-4').style.display = '';
            } else {
                card.closest('.col-md-4').style.display = 'none';
            }
        });
    });

    // Collect and apply filters
    function applyFilters() {
        const selectedGenres = Array.from(document.querySelectorAll('input[name="GenreIds"]:checked'))
            .map(checkbox => checkbox.value);
        const year = document.querySelector('input[name="Year"]').value;
        const sortBy = document.querySelector('select[name="SortBy"]').value;
        const descending = document.querySelector('select[name="Descending"]').value === 'true';

        const movieCards = document.querySelectorAll('.movie-card');

        movieCards.forEach(card => {
            const genres = card.getAttribute('data-genres').split(',');
            const movieYear = card.getAttribute('data-year');

            // Genre filter
            const genreMatch = selectedGenres.length === 0 || 
                selectedGenres.some(genre => genres.includes(genre));

            // Year filter
            const yearMatch = !year || movieYear === year;

            // Show/hide based on filters
            card.closest('.col-md-4').style.display = (genreMatch && yearMatch) ? '' : 'none';
        });
    }

    // Add event listeners to filter inputs
    document.querySelectorAll('input[name="GenreIds"]').forEach(checkbox => {
        checkbox.addEventListener('change', applyFilters);
    });
    document.querySelector('input[name="Year"]').addEventListener('input', applyFilters);
    document.querySelector('select[name="SortBy"]').addEventListener('change', applyFilters);
    document.querySelector('select[name="Descending"]').addEventListener('change', applyFilters);
});
</script>