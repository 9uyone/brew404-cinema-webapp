@using System.Globalization
@using BusinessLogic.DTOs
@using BusinessLogic.Services
@using DataAccess.EntityModels
@using Microsoft.AspNetCore.Identity
@using WebApp.ViewModels
@using WebApp.Controllers
@using System.Collections.Generic;
@model SessionDetailsViewModel

@inject UserManager<User> userManager

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.Session.Movie.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/SessionDetailsStyles.css">
    <style>
        .seats-container {
        display: grid;
        grid-template-columns: repeat( @Model.Session.Hall.SeatsPerRow, 1fr);
        gap: 8px;
        margin-bottom: 20px;
        width: max-content;
        }
    </style>
</head>

<body>
    @{
        var selectedDate = Model.SelectedSeats;  // Вибір першої доступної дати
    }
    <div class="movie-container">
        <div class="movie-info">
            <img src="@Model.Session.Movie.ImageUrl" alt="@Model.Session.Movie.Title" class="movie-poster">
            <div class="movie-details">
                <h1>
                    @Model.Session.Movie.Title
                    <span class="age-rating">@Model.Session.Movie.VoteAverage ⭐</span>
                    <span class="quality-3d">@Model.Session.Hall.Name</span>
                    <span class="quality-4k">4K</span>
                </h1>
                <p><strong>Genres:</strong> @string.Join(", ", Model.Session.Movie.Genres.Select(g => g.Name))</p> @*ПОНЯТТЯ НЕМАЮ ЧОГО НЕ ПРАЦЮЄ *@
                <p><strong>Release Date:</strong> @Model.Session.Movie.ReleaseDate</p>
                <p><strong>Runtime:</strong> @Model.Session.Movie.RunTime</p>
                <p><strong>Overview:</strong> @Model.Session.Movie.Overview</p>
            </div>
        </div>

        <div class="screening-info">
            <span>П'ятниця, 07.02.2025</span>
            <span>
                @Model.Session.StartTime.ToString("HH:mm")
            </span>
            <span>Львів, ТРЦ Форум</span>
            <span>Зал №2</span>
        </div>

        <div class="price-options">
            <span class="price-tag blue">190 грн</span>
            <span class="price-tag green">420 грн</span>
            <span class="price-tag gray">Продані</span>
        </div>

        <div class="seating-area">
            <div class="seats-section">
                <div class="screen"></div>
                <div class="seats-container" id="seatsContainer">
                    @for (int i = 1; i <= Model.Session.Hall.NumbOfRows; ++i)
                    {
                        for (int j = 1; j <= Model.Session.Hall.SeatsPerRow; ++j)
                        {
                            if (Model.OccupiedSeats.Contains(new Tuple<int, int>(i, j)))
                            {
                                <div class="seat seat-disabled" id="seat-@i-@j"></div>
                            }
                            else
                            {
                                <div class="seat" id="seat-@i-@j" onclick=" toggleSeat(event, @i, @j);"></div>
                            }
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="booking-panel">
        <h3>Ваше бронювання</h3>
        <div id="bookingDetails">
            @foreach (var seat in Model.SelectedSeats)
            {
                <div class="booking-details">
                    <span>(@seat.Item1, @seat.Item2)</span>
                </div>
            }
        </div>
        <div class="total-price">
            <span>Всього до сплати:</span>
            <span id="totalPrice">0 грн</span>
        </div>

        <form method="post" asp-controller="Tickets" asp-action="CreateTicket">
            <input type="hidden" name="UserId" value="@((await userManager.FindByNameAsync(User.Identity.Name)).Id)" />
            <input type="hidden" name="SessionId" value="@Model.Session.Id" />
            <input type="hidden" id="selectedSeatsInput" name="SelectedSeats" />
            <button class="buy-button">Купити</button>
        </form>
        <button class="buy-button" onclick="getSelectedSeats();">Купити</button>
    </div>

    <!--<script src="~/js/SessionDetailsScript.js"></script>-->
    <script>
		let selectedSeats = new Map();
		const price = 100;

        function toggleSeat (event, row, col) {
            var seat = event.target;

            if (selectedSeats.has(seat.id)) {
                selectedSeats.delete(seat.id);
                seat.classList.remove("seat-selected");
            } else {
                selectedSeats.set(seat.id, {row, col});
                seat.classList.add("seat-selected");
            }

			document.getElementById("selectedSeatsInput").value = JSON.stringify([...selectedSeats.values()]);
            updateBooking();
        }

        function updateBooking() {
            bookingDetails.innerHTML = "";
            totalPrice = 0;

            selectedSeats.forEach(({ type, price }, seatId) => {
                console.log(seatId);
                const detail = document.createElement("div");
                detail.className = "booking-details";
                detail.innerHTML = `<span>${type} (${seatId})</span><span>${price} грн</span>`;
                bookingDetails.appendChild(detail);
                totalPrice += price;                
            });

            totalPriceElement.textContent = `${totalPrice} грн`;
        }

        function getSelectedSeats() {
            console.log(selectedSeats);
        }
    </script>
</body>
</html>