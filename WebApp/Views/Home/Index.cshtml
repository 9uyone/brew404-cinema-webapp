@using System.Collections.Generic;
@using BusinessLogic.DTOs;
@using Microsoft.AspNetCore.Identity
@model MoviesAndPremieres
@using DataAccess.EntityModels
@inject SignInManager<User> signInManager

@{
    ViewData["Title"] = "Головна сторінка";
}

<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>КіноСайт</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="css/styles.css">
    <link rel="stylesheet" href="css/Main/RecBnt.css" />

    <style>
        .carousel-control-prev:hover,
        .carousel-control-next:hover {
        transform: scale(1.5);
        transition: transform 0.3s ease-in-out; /* Додаємо плавність анімації */
        }

        /* Основне зображення */
        .banner-img {
        width: 100%;
        height: 600px; /* Регулюй висоту */
        background-size: cover;
        background-position: center;
        position: relative;
        }

        /* Затемнення */
        .banner-img::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;

        background: linear-gradient(to bottom, rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 1));
        }

        .carousel-caption {
        position: absolute;
        bottom: 50px;
        left: 200px;
        display: flex;
        height: auto;
        align-items: center; /* Вирівнює по центру вертикально */
        gap: 15px; /* Відступ між зображенням і текстом */
        text-align: left;
        color: white;
        width: 50%; /* Додає ширину для тексту */
        padding: 10px;
        }

        /* Мініатюра (аватар) */
        .overlay-img {
        width: auto;
        height: 300px;
        border-radius: 5%;
        }

        .carousel-item:hover .overlay-img {
            transform: scale(1.05); /* Легке збільшення */
            box-shadow: 0px 0px 20px rgba(255, 255, 255, 0.3); /* Підсвічування */
            transition: transform 0.3s ease, box-shadow 0.3s ease; /* Плавний ефект */
        }


        /* Контейнер для тексту */
        .text-content {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        }

        /* Реакції */
        .reactions {
        display: flex;
        gap: 10px;
        font-size: 20px;
        margin-top: 10px;
        }

        .card:hover {
        transform: scale(1.05); /* Легке збільшення */
        box-shadow: 0px 0px 20px rgba(255, 255, 255, 0.3); /* Підсвічування */
        }

        /* Збільшення розміру каруселі */
        .carousel {
        top: 50%; /* Можна змінити за потреби */
        }

    </style>
</head>
<body>

    <!-- Banner Section -->
    <div id="mainCarousel" class="carousel slide mt-3" data-bs-ride="carousel">
        <div class="carousel-inner">
            @for (int i = 0; i < Model.Movies.Count; i++)
            {
                var isActiveClass = i == 0 ? "active" : "";
                var movie = Model.Movies[i];
                <div class="carousel-item @isActiveClass position-relative">
                    <a asp-action="Details" asp-controller="Home" asp-route-id="@movie.Id" class="text-decoration-none">
                    <!-- Фонова картинка -->
                    <div class="banner-img" style="background-image: url('@movie.BackgroundUrl');"></div>

                    <!-- Контент поверх -->
                    <div class="carousel-caption">
                            <img src="@movie.ImageUrl" class="overlay-img" />
                        <!-- Обгортка для тексту -->
                        <div class="text-content">
                            <h2 style="color: white">@movie.Title</h2>

                            <div class="reactions mt-2">
                                @{
                                    DateTime? releaseDate = null;
                                    DateTime parsedDate;
                                    if (DateTime.TryParseExact(movie.ReleaseDate, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out parsedDate))
                                    {
                                        releaseDate = parsedDate;
                                    }
                                }
                                @if (releaseDate.HasValue && releaseDate.Value <= DateTime.Today)
                                {
                                    <span style="color: white">@movie.VoteAverage ⭐</span>
                                }
                                else
                                {
                                    <text>Очікується прем'єра</text>
                                }
                            </div>
                            <ul style="list-style-type: none; padding: 0; display: flex; flex-wrap: wrap;" class="mt-2">
                                @{
                                    foreach (var genre in movie.Genres)
                                    {
                                        <li style="margin-right: 15px; font-size: 16px; background-color: transparent; padding: 5px 10px; border: 1px solid white; border-radius: 15px; color: white; transition: all 0.3s ease;">
                                            @genre.Name
                                        </li>
                                    }
                                }
                            </ul>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#mainCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#mainCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>


    <!-- Premieres Section -->
    <div id="premiereCarousel" class="carousel slide mt-5" data-bs-ride="false">
        <h2>Найсвіжіші прем'єри</h2>
        <div class="carousel-inner">
            @{
                var moviesPerSlide = 3;
                var totalMovies = Model.Premieres.Count;
                var movieGroups = Model.Premieres.OrderByDescending(movie => movie.ReleaseDate)
                .Select((movie, index) => new { movie, index })
                .GroupBy(x => x.index / moviesPerSlide)
                .ToList();

                for (int i = 0; i < movieGroups.Count; i++)
                {
                    var isActive = i == 0 ? "active" : "";
                    <div class="carousel-item @isActive">
                        <div class="row d-flex justify-content-start">
                            @foreach (var item in movieGroups[i])
                            {
                                var movie = item.movie;
                                <div class="col-md-4 col-sm-6 col-12 mb-3">
                                    <a asp-action="Details" asp-controller="Home" asp-route-id="@movie.Id" class="text-decoration-none">
                                        <div class="card" style="position: relative;">
                                            <img src="@movie.ImageUrl" class="card-img-top fixed-size" alt="@movie.Title">
                                            <div class="card-body">
                                                <h5 class="card-title" style="color: white">@movie.Title</h5>
                                                <h5 class="card-title" style="color: lightgrey;">@movie.ReleaseDate</h5>
                                            </div>
                                            <h5 class="card-title" style="color: white; position: absolute; bottom: 100px; left: 10px; background-color: rgba(0, 0, 0, 0.6); padding: 5px 10px; border-radius: 5px;">
                                                @{
                                                    DateTime? releaseDate = null;
                                                    DateTime parsedDate;
                                                    if (DateTime.TryParseExact(movie.ReleaseDate, "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out parsedDate))
                                                    {
                                                        releaseDate = parsedDate;
                                                    }
                                                }
                                                @if (releaseDate.HasValue && releaseDate.Value <= DateTime.Today)
                                                {
                                                    @movie.VoteAverage <text>⭐</text>
                                                }
                                                else
                                                {
                                                    <span style="font-weight: bold; font-size: 16px;">Очікується прем'єра</span>
                                                }
                                            </h5>
                                        </div>
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Кнопки керування каруселлю -->
        <button class="carousel-control-prev" type="button" data-bs-target="#premiereCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Попередній</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#premiereCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Наступний</span>
        </button>
    </div>

    @if (signInManager.IsSignedIn(User))
    {
        <a asp-controller="Recommendations" asp-action="Index" class="fixed-button btn btn-lg">
            Для вас
        </a>
    }


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>