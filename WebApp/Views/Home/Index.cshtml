@using System.Collections.Generic;
@using BusinessLogic.DTOs;
@model List<MovieDTO>

<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>КіноСайт</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="css/styles.css">
    <style>
        .carousel-control-prev:hover,
        .carousel-control-next:hover {
            transform: scale(1.5);
            transition: transform 0.3s ease-in-out; /* Додаємо плавність анімації */
        }

        .card:hover {
            transform: scale(1.05); /* Легке збільшення */
            box-shadow: 0px 0px 20px rgba(255, 255, 255, 0.3); /* Підсвічування */
        }
    </style>
</head>
<body>

    <!-- Banner Section -->
    <div id="mainCarousel" class="carousel slide mt-3" data-bs-ride="carousel">
        <div class="carousel-inner">
            @for (int i = 0; i < Model.Count; i++)
            {
                var isActiveClass = i == 0 ? "active" : "";
                var movie = Model[i];
                <div class="carousel-item @isActiveClass">
                    <a asp-action="Details" asp-controller="Home" asp-route-id="@movie.Id">
                        <img src="@movie.BackgroundUrl" class="d-block w-100 banner-img" alt="@movie.Title">
                        <div class="carousel-caption d-none d-md-block">
                            <h3>@movie.Title</h3>
                            <!-- ПОМІНЯНО: Кнопка видалена -->
                        </div>
                    </a>
                </div>
            }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#mainCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#mainCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>

    <!-- Premieres Section -->
    <div class="container mt-5">
        <h2>Найсвіжіші прем'єри</h2>
        <div class="row d-flex justify-content-start">
            @{
                var min = Math.Min(3, Model.Count);
                var topByDate = Model.OrderByDescending(movie => movie.ReleaseDate).Take(min).ToList();
                for(int i = 0; i < min; i++)
                {
                    var movie = topByDate[i];
                    <div class="col-md-4 col-sm-6 col-12 mb-3">
                        <a asp-action="Details" asp-controller="Home" asp-route-id="@movie.Id" class="text-decoration-none">
                            <div class="card">
                                <img src="@movie.ImageUrl" class="card-img-top fixed-size" alt="@movie.Title">
                                <div class="card-body">
                                    <h5 class="card-title" style="color: white">@movie.Title</h5>
                                    <h5 class="card-title" style="color: lightgrey">@movie.ReleaseDate</h5>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            }
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="js/main.js"></script>
</body>
</html>