﻿@using System.Globalization
@using WebApp.ViewModels
@model MovieDetailsViewModel

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Detailed view of a movie with recommendations and ticket booking options">
    <meta name="keywords" content="cinema, movie details, tickets, recommendations">
    <meta name="author" content="Cinema Website">
    <title>Cinema - Movie Details</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        /* Контейнер каруселі */
        .actor-carousel,
        .movie-carousel {
        flex-wrap: nowrap; /* Запобігає переходу на новий рядок */
        gap: 15px; /* Відступ між картками */
        scroll-behavior: smooth; /* Плавний скрол */
        overflow-x: auto; /* Горизонтальна прокрутка */
        padding-bottom: 10px;
        }

        /* Картка актора */
        .actor-card,
        .movie-card {
        flex: 0 0 150px; /* Фіксована ширина картки */
        border-radius: 15px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        transition: transform 0.2s ease;
        }
        .movie-card {
        width: 250px;
        height: 250px;
        }

        .actor-card:hover,
        .movie-card:hover {
        transform: scale(1.05); /* Легка анімація при наведенні */
        }

        /* Зображення актора */
        .actor-card img,
        .movie-card img {
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
        height: 200px; /* Фіксована висота зображення */
        object-fit: cover; /* Обрізати зображення, щоб воно не спотворювалося */
        }

        /* Тіло картки */
        .actor-card .card-body,
        .movie-card .card-body {
        text-align: center;
        padding: 10px;
        }

        body {
        background-image: url('@Model.Movie.BackgroundUrl');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        }

        .main {
            
        }

        .session-highlight.disabled {
        opacity: 0.6; /* Змінюємо прозорість */
        pointer-events: none; /* Забороняємо кліки */
        cursor: default; /* Змінюємо курсор на звичайний */
        }

        body::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.6); /* 0.6 — рівень затемнення */
        z-index: -1; /* Щоб фон був позаду контенту */
        }

        /* Новий стиль для сесій */
        .session-block {
        background: rgba(40,40,40,0.9);
        border-radius: 10px;
        padding: 20px;
        margin-top: 30px;
        }

        .cinema-name {
        color: #ffc107;
        font-size: 1.4rem;
        margin-bottom: 15px;
        }

        .session-time {
        color: white;
        font-size: 1.1rem;
        margin: 8px 0;
        cursor: pointer;
        transition: 0.3s;
        }

        .session-time:hover {
        color: #28a745;
        }
    </style>

</head>
<body>
    <!-- Main content -->
    <main class="container bg-dark">
        @{
            var selectedDate = Model.GroupedSessions.Keys.FirstOrDefault();  // Вибір першої доступної дати
            var groupedSessions = Model.GetSessionsForSelectedDate(selectedDate);  // Отримуємо сеанси для вибраної дати
            var dates = Model.GroupedSessions.Keys.OrderBy(d => d).ToList();
        }
        <div class="row">
            <div class="col-md-4">
                <!-- Картинка фільму -->
                <img src="@Model.Movie.ImageUrl" alt="@Model.Movie.Title" class="movie-poster">
            </div>

            <div class="col-md-8">
                <!-- Назва фільму -->
                <h1>@Model.Movie.Title</h1>
                
                <div class="date-selector">
                    <button class="arrow-btn" id="prevDateBtn"><i class="fas fa-chevron-left"></i></button>
                    <h3>
                        <span class="date" id="selectedDate">@selectedDate.ToString("dd MMMM", new CultureInfo("uk-UA"))</span>
                    </h3>
                    <button class="arrow-btn" id="nextDateBtn"><i class="fas fa-chevron-right"></i></button>
                </div>

                <div class="session-list">
                    <!-- Сеанси для вибраної дати -->
                    @foreach (var session in groupedSessions)
                    {
                        <div class="session-time">@session.StartTime.ToString("HH:mm")</div>
                    }
                </div>
            </div>
        </div>


            <!-- Movie Details and Trailer -->
            <div class="col-md-8">
                <div style="display: flex; align-items: center;">
                    <h1>@Model.Movie.Title</h1>
                    <h3 class="ms-5">@Model.Movie.VoteAverage ⭐</h3>
                </div>
                <br /><br /><br />
                <h5 class="detail-label">Release Date:</h5>
                <h4>@Model.Movie.ReleaseDate</h4>
                <br />
                <h5 class="detail-label">Runtime:</h5>
                <h4>@Model.Movie.RunTime min</h4>
                <br />
                <h5 class="detail-label">Genres:</h5>
                <h4>@String.Join(", ", Model.Movie.Genres.Select(g => g.Name))</h4>
                <br />
                <h5 class="detail-label">Overview:</h5>
                <h4>@Model.Movie.Overview</h4>




                <!-- Trailer -->
                <br /><br />
                <div class="movie-trailer mt-4 trailer-container">
                    <h5>Watch Trailer:</h5>
                    @{
                        var trailerId = Model.Movie.TrailerUrl?.Split("=")[1];
                    }
                    <div class="video-container">
                        <iframe class="embed-responsive-item" src="https://www.youtube.com/embed/@trailerId" allowfullscreen></iframe>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actors Section -->
        <div class="container mt-5">
            <h2 class="mb-4">Actors</h2>
            <div id="actorCarousel" class="actor-carousel d-flex overflow-hidden position-relative">
                @foreach (var credit in Model.Movie.Actors)
                {
                    <div class="card actor-card">

                        <img src="@credit.AvatarUrl" class="card-img-top" alt="@credit.Name">
                        <div class="card-body">
                            <h5 class="card-title" style="color: white">@credit.Name</h5>
                            <p class="card-title" style="color: white">@credit.Character</p>
                        </div>
                    </div>
                }
            </div>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <button id="scrollLeft" class="btn btn-outline-primary">←</button>
                <button id="scrollRight" class="btn btn-outline-primary">→</button>
            </div>
        </div>

        <!-- Recommendations Section -->
        <div class="container mt-5">
            <h2 class="mb-4">You may also like</h2>
            <div id="movieCarousel" class="movie-carousel d-flex overflow-hidden position-relative">
                @foreach (var movie in Model.SimilarMovies)
                {
                    var title = movie.Title.Substring(0, Math.Min(movie.Title.Length, 15));
                    title = (title.Length < movie.Title.Length) ? title + "..." : title;
                    <a asp-action="Details" asp-controller="Home" asp-route-id="@movie.Id" class="text-decoration-none">
                        <div class="card movie-card" style="position: relative;">
                            <img src="@movie.ImageUrl" class="card-img-top" alt="@movie.Title">
                            <div class="movie-body">
                                <h4 class="card-title p-2 text-center" style="color: white">@title</h4>
                            </div>
                            <h5 class="card-title" style="color: white; position: absolute; bottom: 45px; left: 10px; background-color: rgba(0, 0, 0, 0.6); padding: 5px 10px; border-radius: 5px;">
                                @movie.VoteAverage ⭐
                            </h5>
                        </div>
                    </a>
                }
            </div>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <button id="mscrollLeft" class="btn btn-outline-primary">←</button>
                <button id="mscrollRight" class="btn btn-outline-primary">→</button>
            </div>
        </div>
    </main>

    <!-- Footer -->
    @* <footer class="bg-dark text-light py-3">
        <div class="container text-center">
            <p>&copy; 2025 Cinema. All rights reserved.</p>
        </div>
    </footer> *@
    <script>
        document.getElementById('scrollLeft').addEventListener('click', function () {
            document.getElementById('actorCarousel').scrollBy({ left: -200, behavior: 'smooth' });
        });

        document.getElementById('scrollRight').addEventListener('click', function () {
            document.getElementById('actorCarousel').scrollBy({ left: 200, behavior: 'smooth' });
        });

        document.getElementById('mscrollLeft').addEventListener('click', function () {
            document.getElementById('movieCarousel').scrollBy({ left: -200, behavior: 'smooth' });
        });

        document.getElementById('mscrollRight').addEventListener('click', function () {
            document.getElementById('movieCarousel').scrollBy({ left: 200, behavior: 'smooth' });
        });



        var dates = @Html.Raw(Json.Serialize(Model.GroupedSessions.Keys));  // Список всіх доступних дат
        var selectedIndex = 0;

        // Обробка кнопок для перемикання між датами
        document.getElementById('prevDateBtn').addEventListener('click', function () {
            if (selectedIndex > 0) updateDate(selectedIndex - 1);
        });

        document.getElementById('nextDateBtn').addEventListener('click', function () {
            if (selectedIndex < dates.length - 1) updateDate(selectedIndex + 1);
        });

        function updateDate(index) {
            selectedIndex = index;
            var selectedDate = new Date(dates[selectedIndex]);
            document.getElementById('selectedDate').innerText = selectedDate.toLocaleDateString('uk-UA', { day: 'numeric', month: 'long' });

            // Тут потрібно оновити список сеансів для нової дати
            // Напишіть код для завантаження сеансів для нової дати
        }
    </script>
</body>
</html>