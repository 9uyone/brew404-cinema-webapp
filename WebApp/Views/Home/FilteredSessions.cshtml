@foreach (var group in Model.GroupedSessions)
{
    <div class="card mb-5">
        <div class="card-body">
            <img src="@group.Key.BackgroundUrl" class="card-img-top session-img" alt="@group.Key.Title" />
            <h3 class="card-title">@group.Key.Title</h3>

            <hr>
            <h5>Сеанси:</h5>
            <div class="container mt-5">
                <div class="row">
                    @foreach (var session in group.Value)
                    {
                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-4">
                            <a asp-action="SessionDetails" asp-controller="Home" asp-route-id="@session.Id" class="text-decoration-none">
                                <div class="card session-card">
                                    <div class="card-body session-details">
                                        <h5 class="card-text text-white">
                                            @session.StartTime.ToString("d MMMM", new System.Globalization.CultureInfo("uk-UA"))
                                        </h5>
                                        <p class="card-text">
                                            <span class="text-danger" style="font-size: 18px">
                                                @session.StartTime.ToString("HH:mm") - @session.EndTime.ToString("HH:mm")
                                            </span>
                                            <span class="text-muted" style="font-size: 18px">
                                                @session.Hall.Name
                                            </span>
                                        </p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
}



<script>
        document.addEventListener("DOMContentLoaded", function () {
        const filterButtons = document.querySelectorAll(".filter-button");

        filterButtons.forEach(button => {
            const dropdown = button.nextElementSibling;
            const select = dropdown.querySelector("select");
            const buttonText = button.querySelector("span");

            button.addEventListener("click", function (event) {
                event.stopPropagation();
                dropdown.classList.toggle("active");
            });

            select.addEventListener("change", function () {
                const selectedOptions = Array.from(select.selectedOptions).map(option => option.text);

                if (selectedOptions.length > 0) {
                    buttonText.textContent = selectedOptions.join(", ");
                    dropdown.classList.remove("active")
                } else {
                    buttonText.textContent = "вибрати фільм";
                }
            });

            document.addEventListener("click", function (event) {
                if (!button.contains(event.target) && !dropdown.contains(event.target)) {
                    dropdown.classList.remove("active");
                }
            });
        });
    });

        document.addEventListener("DOMContentLoaded", function () {
        const sortButton = document.querySelector(".filter-button[data-filter='sort']");
        const sortDropdown = sortButton.nextElementSibling;

        sortButton.addEventListener("click", function (event) {
            event.stopPropagation();
            sortDropdown.classList.toggle("active");
        });

        document.addEventListener("click", function (event) {
            if (!sortButton.contains(event.target) && !sortDropdown.contains(event.target)) {
                sortDropdown.classList.remove("active");
            }
        });
    });

    document.getElementById('todaySessionsButton').addEventListener('click', function() {
        const today = new Date();
        const formattedDate = today.toISOString().split('T')[0]; // Форматуємо дату як "yyyy-MM-dd"

        // Встановлюємо поточну дату в поле "Date"
        document.querySelector('input[name="Date"]').value = formattedDate;

        // Відправляємо форму
        document.querySelector('form').submit();
    });

        document.querySelector('form').addEventListener('submit', function() {
        const sortBy = document.getElementById('sortBy').value;
        const sortOrder = document.getElementById('sortOrder').value;
        console.log(`Sort By: ${sortBy}, Descending: ${sortOrder}`);
    });

    document.addEventListener("DOMContentLoaded", function () {
        const selectElement = document.querySelector("#movies-dropdown select");
        const button = document.querySelector(".filter-button");

        selectElement.addEventListener("change", function () {
            if (selectElement.selectedOptions.length > 0) {
                button.classList.add("active"); // Додаємо клас, якщо є вибрані елементи
            } else {
                button.classList.remove("active"); // Видаляємо клас, якщо вибрано 0
            }
        });
    });
</script>


