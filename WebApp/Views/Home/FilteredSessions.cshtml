@model WebApp.ViewModels.FilterSessionsViewModel

<link rel="stylesheet" href="@Url.Content("~/css/moviePage.css")">
<link rel="stylesheet" href="~/css/SessionsFilterPage.css" />

<style>
    .session-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: none;
        overflow: hidden;
        border-radius: 10px;
    }

    .session-img {
        height: 250px;
        object-fit: cover;
    }

    .session-details {
        padding: 1rem;
    }

    .session-details p {
        margin-bottom: 0.5rem;
    }

    #movies-dropdown
    {
        width: 300px;
    }
    .filter-dropdown select {
        width: 100%; /* Ширина на 100% батьківського елемента */
        max-width: 300px; /* Максимальна ширина для обмеження */
    }

    /* Стилі прокрутки тільки для #movies-dropdown */
    #movies-dropdown::-webkit-scrollbar {
        width: 12px;
        height: 12px;
    }

    #movies-dropdown::-webkit-scrollbar-thumb {
        background-color: #555;
        border-radius: 10px;
        border: 3px solid #fff;
    }

    #movies-dropdown::-webkit-scrollbar-track {
        background-color: #f1f1f1;
        border-radius: 10px;
    }

</style>

<form method="get" action="@Url.Action("FilteredSessions", "Home")">
    <div class="row">
        <div class="filter-container mt-3" id="filterContainer">

        <div class="filter-section">
            <button type="button" class="filter-button">
                <span>вибрати фільм</span>
            </button>
            <div class="filter-dropdown" id="movies-dropdown">
                <select name="MovieId" multiple class="form-control movie-">
                    @foreach (var movie in Model.Movies)
                    {
                        <option value="@movie.Id" class="movie-label">@movie.Title</option>
                    }
                </select>
            </div>
        </div>

            <div class="filter-section">
                <input type="date" name="Date" class="filter-button">
            </div>

            <div class="filter-section">
                <button type="button" class="filter-button" data-filter="sort">
                    <span>Сортування</span>
                </button>
                <div class="filter-dropdown">
                    <div class="mb-2">
                        <label for="sortBy">Сортувати за</label>
                        <select id="sortBy" name="SortBy" class="form-control">
                            <option value="date">За датою</option>
                        </select>
                    </div>
                    <div>
                        <label for="sortOrder">Напрямок</label>
                        <select id="sortOrder" name="Descending" class="form-control">
                            <option value="false">За зростанням</option>
                            <option value="true">За спаданням</option>
                        </select>

                    </div>
                </div>
            </div>

        <div>
            <button type="submit" class="btn btn-primary">Фільтрувати</button>
        </div>
