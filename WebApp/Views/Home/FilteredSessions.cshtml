@model WebApp.ViewModels.FilterSessionsViewModel

<link rel="stylesheet" href="@Url.Content("~/css/moviePage.css")">
<link rel="stylesheet" href="~/css/SessionsFilterPage.css" />

<style>
    /* Контейнер для постера */
.session-card {
    position: relative;
    border: solid 1px white;
    border-radius: 8px;
    padding: 10px;
    overflow: hidden; /* Запобігає виходу елементів за межі */
}

    .filter-button.active {
        background-color: #8b8ef5; /* Синьо-фіолетовий фон */
    }
    .movie-label {
        display: flex;
        align-items: center;
        padding: 8px 12px;
        margin-bottom: 15px;
        border: 3px solid rgba(64, 47, 181, 0.3);
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        font-size: 15px;
        color: #fff;
        user-select: none;
    }
/* Стилі для постера */
.session-img {
    height: 400px;
    width: 100%; /* Щоб зображення займало всю ширину */
    border-radius: 12px; /* Округлені кути */
    object-fit: cover; /* Обрізає картинку без спотворення */
    filter: brightness(50%) blur(2px); /* Затемнює і додає розмиття */
}

/* Стилі для назви фільму */
.card-title {
    position: absolute;
    top: 20%; /* Центруємо по вертикалі */
    left: 50%; /* Центруємо по горизонталі */
    transform: translate(-50%, -50%); /* Вирівнюємо */
    font-size: 3rem; /* Збільшений розмір тексту */
    font-weight: bold;
    color: white; /* Білий колір для контрасту */
    text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.8); /* Додаємо тінь для кращої читабельності */
    text-align: center;
    width: 90%; /* Запобігає виходу тексту за межі */
    z-index: 10; /* Щоб було поверх постера */
}

    .session-details {
        padding: 1rem;
    }

    .session-details p {
        margin-bottom: 0.5rem;
    }

    #movies-dropdown
    {
        width: 350px;
        height: 500px;
    }
    .filter-dropdown select {
        width: 100%; /* Ширина на 100% батьківського елемента */
        height: 100%;
    }

    #movies-dropdown select::-webkit-scrollbar {
        width: 8px; /* Товщина скролбару */
    }

    #movies-dropdown select::-webkit-scrollbar-track {
        background: #f1f1f1; /* Колір фону треку */
        border-radius: 10px;
    }

    #movies-dropdown select::-webkit-scrollbar-thumb {
        background: #888; /* Колір скроллера */
        border-radius: 10px;
    }

    #movies-dropdown select::-webkit-scrollbar-thumb:hover {
        background: #555; /* Колір при наведенні */
    }

    /* Стиль для Firefox */
    #movies-dropdown select {
        scrollbar-width: thin;
        scrollbar-color: #888 #f1f1f1;
        scrollbar-width: none;
    }

    .session-img {
        height: 400px;
        width: 100%; /* Щоб зображення займало всю ширину */
        border-radius: 12px; /* Округлені кути */
        backdrop-filter: blur(5px);
    }

    .session-card {
        border: solid 1px white;
        border-radius: 8px;
        padding: 10px;
    }

    /* Встановлюємо однаковий розмір для всіх кнопок */
.filter-button,
#todaySessionsButton {
    width: 200px; /* Однакова ширина */
    height: 45px; /* Однакова висота */
    font-size: 18px; /* Розмір тексту */
    font-weight: bold; /* Жирний текст */
    margin: 5px 0; /* Відступи між кнопками */
    background-color: #3E56DDFF;
    color: white; /* Білий текст */
    border: none; /* Без рамки */
    border-radius: 8px; /* Округлені кути */
    cursor: pointer;
    transition: background 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
}

.filter-button:hover,
#todaySessionsButton:hover {
    background-color: #58048e; /* Темніший фіолетовий при наведенні */
}



/* Для контейнера фільтрів (фільм, дата і кнопка фільтрувати) */
.filter-container {
    display: flex;
    justify-content: space-between;
    width: 100%; /* щоб всі елементи займали всю ширину */
    align-items: center;
}

/* Щоб "сеанси сьогодні" стояло праворуч */
#todaySessionsButton {
    margin-left: auto; /* Це переносить кнопку на праву сторону */
}

/* Якщо потрібно додатково налаштувати стиль кнопки "сеанси сьогодні" */
#todaySessionsButton {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #3E56DDFF; /* Синій фон */
    color: white; /* Текст білий */
    font-size: 18px; /* Розмір тексту */
    border-radius: 8px; /* Округлені кути для цієї кнопки */
}

</style>

