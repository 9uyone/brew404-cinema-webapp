@using Microsoft.AspNetCore.Identity
@using DataAccess.EntityModels
@using BusinessLogic.DTOs.Auth
@using WebApp.ViewModels
@inject SignInManager<User> signInManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
   <header style="position: sticky; top: 0; z-index: 100;">
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark shadow-sm py-3">
        <div class="container">
            <!-- Логотип і назва -->
            <div class="d-flex align-items-center">
                <a class="navbar-brand me-3" asp-controller="Home" asp-action="Index">
                    <img src="https://i.ibb.co/pjyQMk7G/IMG-9011.jpg" alt="IMG-9011" border="0"
                         alt="Логотип 404-Cinema" 
                         style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover;">
                </a>
                <h4 class="mb-0 text-uppercase fw-bold" style="letter-spacing: 2px; color: white;">404-Cinema</h4>
            </div>

            <!-- Навігація -->
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav align-items-center">
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item mx-2">
                            <a class="nav-link position-relative hover-effect"
                                href="/admin/Panel">
                                Aдмін
                            </a>
                        </li>
                    }
                    <li class="nav-item mx-2">
                        <a class="nav-link position-relative hover-effect" 
                           asp-controller="Home"
                           asp-action="FilteredMovies">
                           Фільми
                        </a>
                    </li>
                    <li class="nav-item mx-2">
                        <a class="nav-link position-relative hover-effect"
                           asp-controller="Home"
                           asp-action="FilteredSessions">
                           Сеанси
                        </a>
                    </li>

					@if (signInManager.IsSignedIn(User))
					{
                        <li class="nav-item mx-2">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-light px-4 py-2 rounded-pill">
                                    Вийти
                                </button>
                            </form>
                        </li>
					}
                    else
                    {
                        <li class="nav-item mx-2">
                            <button class="btn btn-outline-light px-4 py-2 rounded-pill" 
                                    data-bs-toggle="modal" 
                                    data-bs-target="#loginModal">
                                Увійти
                            </button>
                        </li>
                    }
                </ul>
            </div>

            <!-- Мобільне меню -->
            <button class="navbar-toggler border-0" 
                    type="button" 
                    data-bs-toggle="collapse" 
                    data-bs-target="#navbarNav" 
                    aria-controls="navbarNav" 
                    aria-expanded="false" 
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>
    </nav>
</header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white mt-5 py-4">
        <div class="container">
            <div class="row d-flex justify-content-between">
                <div class="col-md-3">
                    <h5>Про компанію</h5>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-white text-decoration-none">Про нас</a></li>
                        <li><a href="#" class="text-white text-decoration-none">Новини</a></li>
                        <li><a href="#" class="text-white text-decoration-none">Партнери</a></li>
                        <li><a href="#" class="text-white text-decoration-none">Контакти</a></li>
                        <li><a href="#" class="text-white text-decoration-none">Політика конфіденційності</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h5>Адреса</h5>
                    <p>Національний лісотехнічний університет України.</p>
                    <p>Адміністративний корпус НЛТУ, вулиця Генерала Чупринки, 103, Львів, Львівська область, 79057</p>
                </div>
                <div class="col-md-3">
                    <h5>Служба підтримки</h5>
                    <p>Ми завжди готові допомогти вам!</p>
                    <p>
                        <a href="mailto:dmytrofeedback@gmail.com" class="text-white text-decoration-none">dmytrofeedback@gmail.com</a>
                    </p>
                </div>
            </div>
            <hr class="border-light">
            <div class="d-flex justify-content-between align-items-center">
                <p class="mb-0">© Brew 404 2018-2025. Всі права захищені.</p>
                <div>
                    <a href="https://www.facebook.com/pk.nltu/" class="text-white text-decoration-none mx-2">Facebook</a>
                    <a href="https://t.me/pk_nltu" class="text-white text-decoration-none mx-2">Telegram</a>
                    <a href="https://www.youtube.com/watch?v=dQw4w9WgXcQ" class="text-white text-decoration-none mx-2">YouTube</a>
                </div>
            </div>
        </div>
    </footer>

	@if (!signInManager.IsSignedIn(User))
	{
        <partial name="_LoginModal" model="@new LoginDTO()" />
        <partial name="_RegModal" model="@new RegisterDTO()" />
	})

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@* *@