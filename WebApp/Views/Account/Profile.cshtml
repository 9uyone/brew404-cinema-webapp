              <div class="label">Місце</div>
              <div class="value">Ряд 7, Місце 12</div>
            </div>
            <div class="ticket-info">
              <div class="label">Ціна</div>
              <div class="value">120 грн</div>
              <div class="label">Статус</div>
              <div class="value">Оплачено</div>
            </div>
          </div>
        </div>
