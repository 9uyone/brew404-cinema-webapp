<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Персональний кабінет</title>
  <style>
    *, ::after, ::before {
    box-sizing: border-box;
    /* Базові стилі */
    body {
      background-color: #121212;
      color: #ffffff;
      line-height: 1.6;
      margin: 0;
      padding: 0;
      min-height: 100vh;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .container {
      display: flex;
      flex-wrap: wrap;
      gap: 30px;
      max-width: 1400px;
      margin: 40px auto;
      padding: 0 20px;
      
    }

    /* Сайдбар */
    .sidebar {
      flex: 1;
      min-width: 280px;
      max-width: 100%;
      display: flex;
      flex-direction: column;
      gap: 15px;
      background: #1e1e1e;
      border-radius: 12px;
      padding: 25px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
      height: fit-content;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .profile-section {
      display: flex;
      align-items: center;
      gap: 20px;
      margin-bottom: 30px;
      flex-wrap: wrap;
    }

    /* Блок аватарки */
    .avatar {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      overflow: hidden;
      border: 3px solid rgba(64, 47, 181, 0.3);
      cursor: pointer;
      position: relative;
    }

    .avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .nav-btn {
      background: rgba(32, 32, 32, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: #fff;
      padding: 16px 25px;
      border-radius: 12px;
      cursor: pointer;
      text-align: left;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 16px;
      width: 100%;
      
    }

    .nav-btn:hover {
      background: rgba(45, 45, 45, 0.95);
      border-color: rgba(255, 255, 255, 0.2);
    }

    .nav-btn.active {
      background: rgba(64, 47, 181, 0.2);
      border-color: #402fb5;
    }

    /* Основний контент */
    .content {
      flex: 3;
      min-width: 280px;
      background: #1e1e1e;
      border-radius: 12px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .content-header {
      padding: 25px 35px;
      background: #2c2c2c;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .content-header h1 {
      font-size: 24px;
      font-weight: 600;
      margin: 0;
      color: #ffffff;
    }

    .edit-btn {
      background: #402fb5;
      border: none;
      color: #fff;
      padding: 10px 25px;
      border-radius: 20px;
      cursor: pointer;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .edit-btn:hover {
      opacity: 0.9;
      transform: translateY(-1px);
    }


    /* Сітка даних */
    .data-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 25px;
      padding: 30px;
    }

    .data-item {
      flex: 1;
      min-width: 250px;
      background: #2c2c2c;
      padding: 25px;
      border-radius: 12px;
      border: 1px solid rgba(64, 47, 181, 0.3);
      transition: transform 0.3s ease;
    }

    .data-item:hover {
      transform: translateY(-3px);
      border-color: #402fb5;
      box-shadow: 0 8px 24px rgba(255, 255, 255, 0.1);
    }

    .data-label {
      color: rgba(255, 255, 255, 0.5);
      font-size: 14px;
      margin-bottom: 10px;
    }

    .data-value {
      font-size: 18px;
      font-weight: 500;
      color: #ffffff;
    }

    /* Квитки */
    .ticket {
      background: #2c2c2c;
      border-radius: 12px;
      margin: 20px;
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 0;
      border: 1px solid rgba(255, 255, 255, 0.1);
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .ticket:hover {
      border-color: #402fb5;
      box-shadow: 0 8px 24px rgba(255, 255, 255, 0.1);
      transform: translateY(-3px);
    }

    .ticket-info {
      padding: 20px;
      position: relative;
    }

    .ticket-info:not(:last-child)::after {
      content: '';
      position: absolute;
      right: 0;
      top: 10px;
      bottom: 10px;
      width: 1px;
      background: rgba(255, 255, 255, 0.1);
    }

    .ticket::before,
    .ticket::after {
      content: '';
      position: absolute;
      width: 20px;
      height: 20px;
      background: #121212;
      border-radius: 50%;
    }

    .ticket::before {
      top: -10px;
      left: calc(33.33% - 10px);
      box-shadow: 
        calc(33.33% + 20px) 0 #121212,
        0 0 0 1px rgba(255, 255, 255, 0.1);
    }

    .ticket::after {
      bottom: -10px;
      left: calc(33.33% - 10px);
      box-shadow: 
        calc(33.33% + 20px) 0 #121212,
        0 0 0 1px rgba(255, 255, 255, 0.1);
    }

    .ticket-info .label {
      color: rgba(255, 255, 255, 0.5);
      font-size: 12px;
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .ticket-info .value {
      color: #ffffff;
      font-size: 16px;
      font-weight: 500;
    }

    /* Кнопка виходу */
    .logout {
      margin-top: auto;
      background: rgba(32, 32, 32, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: #ff5e5e;
      padding: 16px;
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 500;
      width: 100%;
      
    }

    .logout:hover {
      background: rgba(45, 45, 45, 0.95);
      border-color: rgba(255, 255, 255, 0.2);
      color: #ff7474;
    }

    /* Секції */
    section {
      transition: opacity 0.4s ease, transform 0.4s ease;
      opacity: 0;
      transform: translateY(20px);
      position: absolute;
      width: 100%;
      height: 100%;
      display: none;
    }

    section.active {
      opacity: 1;
      transform: translateY(0);
      display: block;
      position: relative;
    }
  </style>
</head>
<body>
  <div class="container">
    <aside class="sidebar">
      <div class="profile-section">
        <div class="avatar" id="avatarContainer">
          <img src="https://marketplace.canva.com/EAFqhoRVTgA/1/0/1600w/canva-grey-and-blue-cute-cartoon-anime-manga-illustrated-boy-profile-photo-avatar-u9aFvuQMzUk.jpg" alt="avatar icon" id="currentAvatar">
        </div>
        <h2>@User.Identity.Name</h2>
      </div>
      <button class="nav-btn active" data-section="personal-data">Персональні дані</button>
      <button class="nav-btn" data-section="tickets">Активні квитки</button>
      <button class="nav-btn" data-section="history">Історія покупок</button>
     <form action="@Url.Action("Logout", "Account")" method="post">
         @Html.AntiForgeryToken()
        <button type="submit" class="logout">Вихід</button>
        </form>


    </aside>
    
    <main class="content">
      <section class="personal-data-section active">
        <div class="content-header">
          <h1>Персональні дані</h1>
          <button class="edit-btn">Редагувати</button>
        </div>
        <div class="content-body">
          <div class="data-grid">
            <div class="data-item">
              <div class="data-label">Ім'я</div>
              <div class="data-value">@User.Identity.Name</div>
            </div>
            <div class="data-item">
              <div class="data-label">Пошта</div>
              <div class="data-value">kacurdavid@gmail.com</div>
            </div>
            <div class="data-item">
              <div class="data-label">Дата народження</div>
              <div class="data-value">4 квітня 2005</div>
            </div>
            <div class="data-item">
              <div class="data-label">Номер телефону</div>
              <div class="data-value">+380 (93) 748 89 50</div>
            </div>
          </div>
        </div>
      </section>

      <section class="tickets-section">
        <div class="content-header">
          <h1>Активні квитки</h1>
        </div>
        <div class="content-body">
          <div class="ticket">
            <div class="ticket-info">
              <div class="label">Фільм</div>
              <div class="value">Назва фільму</div>
              <div class="label">Дата та час</div>
              <div class="value">12 лютого, 19:30</div>
            </div>
            <div class="ticket-info">
              <div class="label">Зал</div>
              <div class="value">Зал 3</div>
              <div class="label">Місце</div>
              <div class="value">Ряд 7, Місце 12</div>
            </div>
            <div class="ticket-info">
              <div class="label">Ціна</div>
              <div class="value">120 грн</div>
              <div class="label">Статус</div>
              <div class="value">Оплачено</div>
            </div>
          </div>
        </div>
      </section>

      <section class="history-section">
        <div class="content-header">
          <h1>Історія покупок</h1>
        </div>
        <div class="content-body">
          <div class="ticket">
            <div class="ticket-info">
              <div class="label">Фільм</div>
              <div class="value">Назва фільму</div>
              <div class="label">Дата та час</div>
              <div class="value">12 лютого, 19:30</div>
            </div>
            <div class="ticket-info">
              <div class="label">Зал</div>
              <div class="value">Зал 3</div>
              <div class="label">Місце</div>
              <div class="value">Ряд 7, Місце 12</div>
            </div>
            <div class="ticket-info">
              <div class="label">Ціна</div>
              <div class="value">120 грн</div>
              <div class="label">Статус</div>
              <div class="value">Оплачено</div>
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <script>
    // Логіка перемикання секцій
  document.querySelectorAll('.nav-btn').forEach(button => {
    button.addEventListener('click', () => {
      document.querySelectorAll('.nav-btn').forEach(btn => btn.classList.remove('active'));
      document.querySelectorAll('section').forEach(section => section.classList.remove('active'));

      button.classList.add('active');

      const sectionName = button.getAttribute('data-section');
      // Corrected line using template literals:
      document.querySelector(`.${sectionName}-section`).classList.add('active');
      // Alternatively, you could use:
      // document.querySelector('.' + sectionName + '-section').classList.add('active');
    });
  });

  // Нова логіка для аватарки: при кліку змінюється на наступне зображення
  document.addEventListener('DOMContentLoaded', function() {
    const avatarContainer = document.getElementById('avatarContainer');
    const currentAvatar = document.getElementById('currentAvatar');
    const avatars = [
      "https://marketplace.canva.com/EAFqhoRVTgA/1/0/1600w/canva-grey-and-blue-cute-cartoon-anime-manga-illustrated-boy-profile-photo-avatar-u9aFvuQMzUk.jpg",
      "https://static.vecteezy.com/system/resources/thumbnails/009/749/751/small_2x/avatar-man-icon-cartoon-male-profile-mascot-illustration-head-face-business-user-logo-free-vector.jpg",
      "https://img.freepik.com/free-vector/smiling-young-man-illustration_1308-174401.jpg?semt=ais_hybrid",
      "https://i.etsystatic.com/39063034/r/il/cb88ab/4893801479/il_570xN.4893801479_e4tq.jpg",
      "https://w7.pngwing.com/pngs/439/837/png-transparent-avatar-face-girl-female-woman-profile-happy-avatar-icon.png",
      "https://i.fbcd.co/products/resized/resized-750-500/s211206-kids-avat001-mainpreview-68e535dc97667c8fffa14c6da9e6f5787447ab7513f0fee9a9a39b9856312c9c.jpg"
    ];
    let currentIndex = avatars.indexOf(currentAvatar.src);
    if (currentIndex === -1) {
      currentIndex = 0;
      currentAvatar.src = avatars[currentIndex];
    }
    avatarContainer.addEventListener('click', function(e) {
      e.stopPropagation();
      currentIndex = (currentIndex + 1) % avatars.length;
      currentAvatar.src = avatars[currentIndex];
    });
  });
  </script>
</body>
</html>